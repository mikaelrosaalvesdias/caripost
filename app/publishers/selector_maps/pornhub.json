{
    "platform": "pornhub",
    "version": "2026-04",
    "selectors": {
        "file_input": "#uploadVideoFile, input[type='file']",
        "title": "#videoTitle, input[name='title']",
        "description": "#videoDescription, textarea[name='description']",
        "tags": "#videoTags, input[name='tags']",
        "category": "#videoCategory, select[name='category']",
        "thumbnail": "input[name='thumb'], .thumbnailUpload input[type='file']",
        "submit": "#submitVideo, .upload-submit, button[type='submit']",
        "upload_complete": ".upload-complete, .uploadCompleted",
        "logged_in_indicator": ".usernameWrap, .user-avatar, .topUserbarName",
        "login_username": "#username, input[name='username']",
        "login_password": "#password, input[name='password']",
        "login_submit": "button[type='submit'], .loginButton",
        "video_views": ".count, .viewsWrapper .count",
        "video_likes": ".votesUp, .ratingPositive .number",
        "video_comments": ".numComments, .commentsCount",
        "video_rating": ".percent, .ratingPercent"
    }
}
